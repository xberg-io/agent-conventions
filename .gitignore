**/.ai-rulez/.generated-manifest.local.json
plugin/.ai-rulez/.generated-manifest.json
.agents/settings.json
.claude/settings.json
.claude/plugins.json
.codex/commands/
.codex/plugins.json
.cursor/
.github/commands/

# Machine-local ai-rulez overlays; kept outside the managed block so a regenerate cannot drop them.
.ai-rulez/config.local.*
.ai-rulez/local/
